# Поставщик LLM: anthropic (локально) или yandex (VPS в РФ).
LLM_PROVIDER=anthropic

# Anthropic — только если API доступен с хоста (не с типичного VPS в России).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Yandex Cloud Foundation Models: API-ключ сервисного аккаунта и folder id каталога.
# Консоль: https://console.cloud.yandex.ru/ → AI → Foundation Models.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# Голос по шагам: browser (бесплатно) | yandex (SpeechKit, push-to-talk) | off
VOICE_MODE=browser
# VOICE_STT_ENABLED=1
# VOICE_MODE=yandex

MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
CATALOG_PATH=vendor/mock/data/vehicles.json
FAULTS_PATH=vendor/mock/data/fault_types.json
MANUALS_DIR=data/manuals
INDEX_DIR=data/index
DB_PATH=data/app.db
MAX_STEPS=8
MAX_OUTPUT_TOKENS=1024

# Локальные embeddings (индекс руководств, не LLM).
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
# HF_HOME=C:\path\to\hf-cache
# SKIP_EMBEDDINGS=1