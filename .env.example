# Ключ только локально. В Git не класть.
ANTHROPIC_API_KEY=
# Обвязка и отладка: claude-haiku-5-5. Прогон качества и демо: claude-sonnet-5-5.
# claude-opus-5-5 — только если Sonnet не проходит контрольные случаи.
ANTHROPIC_MODEL=claude-haiku-5-5
MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
CATALOG_PATH=vendor/mock/data/vehicles.json
FAULTS_PATH=vendor/mock/data/fault_types.json
MANUALS_DIR=data/manuals
INDEX_DIR=data/index
DB_PATH=data/app.db
MAX_STEPS=8
MAX_OUTPUT_TOKENS=1024
